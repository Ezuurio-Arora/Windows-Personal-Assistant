<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Allow cleartext traffic for local network operations -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain rules for local LAN discovery, mDNS, and dev loopbacks -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">personal-assistant.local</domain>
    </domain-config>
</network-security-config>
